{
  "expo": {
    "name": "KURA Clínica",
    "slug": "kura-clinica",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kura-clinica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.kura.clinica"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A52"
      },
      "package": "br.com.kura.clinica"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F2E6",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#14110C"
          }
        }
      ],
      "expo-font",
      "expo-file-system",
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o KURA acesse o microfone para gravar o áudio da consulta e gerar o rascunho SOAP."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o KURA acesse suas fotos para cadastrar a foto do pet.",
          "cameraPermission": "Permitir que o KURA acesse a câmera para fotografar o pet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}